annotation PBI_ProTooling = ["DevMode"]

ref table hechos_titulados
ref table dim_carrera
ref table dim_institucion
ref table dim_territorio
ref table dim_tiempo
ref table Umbral
ref table Arancel

ref cultureInfo en-US

