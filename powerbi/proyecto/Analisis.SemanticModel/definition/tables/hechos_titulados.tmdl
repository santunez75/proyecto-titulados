table hechos_titulados
	lineageTag: 7eb634a7-33be-4c7a-9b46-92048e5d9555

	measure Titulados = COUNTROWS(hechos_titulados)
		formatString: 0
		lineageTag: f71663c8-5631-441a-91a2-6f4cb4e1c921

	measure 'Sobreduración media' = AVERAGE(hechos_titulados[sobreduracion_sem])
		formatString: 0.00
		lineageTag: 8bf895c2-01d1-48cd-a981-60a293a2ba83

	measure '% Titulación oportuna' =
			
			DIVIDE(
			    CALCULATE([Titulados], hechos_titulados[titulacion_oportuna] = TRUE()),
			    [Titulados]
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: d0678711-0c14-4cf8-ac0c-ed845c3f6683

	measure '% Rezago severo' =
			
			DIVIDE(
			    CALCULATE([Titulados], hechos_titulados[categoria_rezago] = "Rezago severo"),
			    [Titulados]
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 146e39e3-1c78-4fd9-b5ce-f083ae98627d

	measure 'Semestres en exceso' = SUM(hechos_titulados[sobreduracion_sem])
		formatString: 0
		lineageTag: e2b29542-5588-4fbf-a680-60e845c9b294

	measure 'Brecha de género (sem)' =
			
			CALCULATE([Sobreduración media], hechos_titulados[genero] = "Hombre")
			    - CALCULATE([Sobreduración media], hechos_titulados[genero] = "Mujer")
		formatString: 0.00
		lineageTag: b1ea155d-4734-4801-90bb-c7d4e12dbc8b

	measure 'Sobreduración media (min 1000)' = IF([Titulados] >= 1000, [Sobreduración media])
		lineageTag: 034394b8-7746-4423-8170-7295176d3a6b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Estudiantes sobre el umbral' =
			
			CALCULATE(
			    [Titulados],
			    FILTER(
			        VALUES(hechos_titulados[prob_rezago]),
			        hechos_titulados[prob_rezago] >= [Umbral Value]
			    )
			)
		formatString: 0
		lineageTag: 18770e82-d727-46ab-84c7-8b09c311d0dc

	measure '% de la cohorte señalada' =
			
			DIVIDE([Estudiantes sobre el umbral], [Titulados])
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 76d18bac-35c2-402f-adc6-7856d902b17e

	measure 'Cobertura del rezago real' =
			
			VAR Rezagados =
			    CALCULATE([Titulados], hechos_titulados[titulacion_oportuna] = FALSE())
			VAR Detectados =
			    CALCULATE(
			        [Titulados],
			        FILTER(
			            VALUES(hechos_titulados[prob_rezago]),
			            hechos_titulados[prob_rezago] >= [Umbral Value]
			        ),
			        hechos_titulados[titulacion_oportuna] = FALSE()
			    )
			RETURN
			    DIVIDE(Detectados, Rezagados)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 755efd45-7573-42ee-9cf4-c8201fd8ca13

	measure 'Duración teórica media' = AVERAGE(hechos_titulados[duracion_teorica_sem])
		formatString: 0.00
		lineageTag: 97d8dbb2-64a3-4842-acc2-5abf00039229

	measure 'Duración real media' = AVERAGE(hechos_titulados[duracion_real_sem])
		formatString: 0.00
		lineageTag: f6bc2a7c-2788-4060-b4fb-7cc71be5c68c

	measure 'Índice de duración' = DIVIDE([Duración real media], [Duración teórica media])
		formatString: 0.00
		lineageTag: 57ad0a40-4c47-4aff-a971-5834c0e8d657

	measure 'Sobreduración mediana' = MEDIAN(hechos_titulados[sobreduracion_sem])
		formatString: 0.0
		lineageTag: f2b152f8-253f-4e31-9215-4b1de6af8fab

	measure '% Titulación anticipada' = DIVIDE(CALCULATE([Titulados], hechos_titulados[sobreduracion_sem] < 0), [Titulados])
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 7b37139c-3035-474e-bf34-7709151336ea

	measure 'Semestres en exceso (positivos)' =
			CALCULATE(SUM(hechos_titulados[sobreduracion_sem]),
			hechos_titulados[sobreduracion_sem] > 0)
		formatString: #,0
		lineageTag: 91267dc2-4d77-4887-976c-1e48e830de2b

	measure 'Costo estimado en aranceles' = [Semestres en exceso (positivos)] * [Arancel Value]
		formatString: \$#,0
		lineageTag: ba65366d-ce8e-4b1b-82f7-7eba536230c3

	measure 'Costo estimado por titulado' = DIVIDE([Costo estimado en aranceles], [Titulados])
		formatString: \$#,0
		lineageTag: edff28ae-e150-44a0-aebb-dd3494933a8d

	measure 'Promedio nacional' = CALCULATE([Sobreduración media], REMOVEFILTERS())
		formatString: 0.00
		lineageTag: 5c1ac848-4205-4295-b751-e4831f8009f2

	measure 'Desviación vs. nacional' = [Sobreduración media] - [Promedio nacional]
		formatString: +0.00;-0.00;0.00
		lineageTag: 86799ebe-45f1-40ed-8b72-5f8b0131a99c

	measure '% sobre el promedio nacional' = DIVIDE([Desviación vs. nacional], [Promedio nacional])
		formatString: +0.0\ %;-0.0\ %;0.0\ %
		lineageTag: c95e665b-5595-4bd9-b8d5-ff65794bd713

	measure 'Semestres extra por titulado' = DIVIDE([Semestres en exceso (positivos)], [Titulados])
		formatString: 0.0
		lineageTag: 076e045f-493c-44a7-8fa7-e66d2dd861ef

	measure 'Costo estimado en aranceles (MM$)' = DIVIDE([Costo estimado en aranceles], 1000000)
		formatString: #,0
		lineageTag: 05b611ff-5d42-48e4-b281-2391845d2c66

	column id_titulado
		dataType: int64
		formatString: 0
		lineageTag: f8e3b4bf-d107-4326-80e5-f44445cf34e1
		summarizeBy: sum
		sourceColumn: id_titulado

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

