	partition hechos_titulados = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("D:\IA Development\proyecto-titulados\powerbi\hechos_titulados.csv"),[Delimiter=";", Columns=20, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"id_titulado", Int64.Type}, {"cod_inst", Int64.Type}, {"id_periodo", Int64.Type}, {"genero", type text}, {"modalidad", type text}, {"jornada", type text}, {"rango_edad", type text}, {"categoria_rezago", type text}, {"cohorte_ingreso", Int64.Type}, {"duracion_teorica_sem", Int64.Type}, {"duracion_real_sem", Int64.Type}, {"sobreduracion_sem", Int64.Type}, {"indice_duracion", type number}, {"titulacion_oportuna", type logical}, {"edad_ingreso", Int64.Type}, {"edad_titulacion", Int64.Type}, {"es_atipico", type logical}, {"id_carrera", Int64.Type}, {"id_territorio", Int64.Type}, {"prob_rezago", type number}})
				in
				    #"Changed Type"

	changedProperty = IsHidden

	annotation PBI_ResultType = Table

