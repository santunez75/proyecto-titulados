# --- Datos ----------------------------------------------------------------
# Los CSV originales del SIES pesan ~955 MB en total (155 MB cada uno) y
# superan el limite de 100 MB por archivo de GitHub. Se distribuyen desde el
# portal oficial y se documenta como obtenerlos en el README.
data/raw/
data/interim/
data/processed/*.parquet

# Si se versiona la muestra reproducible en CSV (5.000 filas, ~1 MB)
!data/processed/muestra_titulados_5000.csv

# --- Entorno --------------------------------------------------------------
.venv/
venv/
env/

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# --- Jupyter --------------------------------------------------------------
.ipynb_checkpoints/
*.nbconvert.ipynb

# --- Sistema operativo y editores ------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# --- Documentos temporales -------------------------------------------------
~$*.docx
~$*.xlsx

# Salidas generadas para Power BI (se regeneran con scripts/exportar_powerbi.py)
powerbi/*.parquet
powerbi/*.csv
powerbi/*.pbix

# --- Entregas formativas ---------------------------------------------------
# El repositorio publica unicamente las entregas sumativas. Los informes
# formativos se conservan en local, fuera del control de versiones.
informe/Formativa*

# --- Ajustes locales de Power BI Desktop -----------------------------------
# Enlazan el proyecto con la cuenta y el equipo donde se abrio: identificador
# del area de trabajo y credenciales cifradas para esa maquina. No sirven en
# otro equipo y no deben publicarse.
powerbi/proyecto/**/.pbi/localSettings.json
